# 复制为 .env 后填写；.env 已被 .gitignore 忽略
# 方案 A：容器内 MySQL 的 huixuetong 用户密码
# 方案 B：宿主机 huixuetong 库密码
DB_PASSWORD=change-me

# 方案 A 的 root 密码（方案 B 可忽略）
MYSQL_ROOT_PASSWORD=change-me-root

# 方案 A 的 Redis 密码（方案 B 若宿主机 Redis 无密码则留空）
REDIS_PASSWORD=change-me-redis

# 必须与加密 config/models.json 时使用的密钥一致。
# 本地开发填 dev-only-default-secret-2026!（= ModelKeyCipher.DEV_SECRET），
# 这样既有值、不触发启动 WARN，又能解开仓库里已有的两条 enc: 密文。
# 留空则回退到同一个开发默认密钥，但每次启动会打 WARN。
MODEL_KEY_SECRET=dev-only-default-secret-2026!

# 生产务必替换
JWT_SECRET=
